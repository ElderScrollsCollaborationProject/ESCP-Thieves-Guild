<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_ThievesGuild</defName>
        <label>Thieves Guild</label>
        <description>The Thieves Guild operates below the surface of every major city in Tamriel, sometimes literally. They do not advertise and they do not recruit openly. You find them, or they find you, and the distinction matters less than most people think. The Guild takes a cut of everything moved through its network: fenced goods, blackmail, information brokered to the right buyer. The Guildmaster keeps order by keeping it profitable. Members who bring heat down on the operation do not stay members.</description>
        <colorSpectrum>
            <li>(0.28, 0.22, 0.38)</li>
        </colorSpectrum>
        <pawnSingular>guild thief</pawnSingular>
        <pawnsPlural>guild thieves</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <hidden>true</hidden>
        <settlementGenerationWeight>0</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <displayInFactionSelection>false</displayInFactionSelection>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <leaderTitle>Guildmaster</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <techLevel>Medieval</techLevel>
        <fixedName>Thieves Guild</fixedName>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_ThievesGuild_Child</li>
                    <li>ESCP_Backstory_ThievesGuild_Thief</li>
                </categories>
                <commonality>0.8</commonality>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_ThievesGuild_Fence</li>
        </caravanTraderKinds>

        <visitorTraderKinds>
            <li>ESCP_Caravan_ThievesGuild_Fence</li>
        </visitorTraderKinds>

        <pawnGroupMakers>

            <li>
                <kindDef>Settlement</kindDef>
                <commonality>100</commonality>
                <options>
                    <ESCP_Pawnkind_ThievesGuild_Cutpurse>3</ESCP_Pawnkind_ThievesGuild_Cutpurse>
                    <ESCP_Pawnkind_ThievesGuild_Operative>2</ESCP_Pawnkind_ThievesGuild_Operative>
                    <ESCP_Pawnkind_ThievesGuild_Master>1</ESCP_Pawnkind_ThievesGuild_Master>
                </options>
            </li>

            <li>
                <kindDef>Peaceful</kindDef>
                <commonality>40</commonality>
                <options>
                    <ESCP_Pawnkind_ThievesGuild_Cutpurse>3</ESCP_Pawnkind_ThievesGuild_Cutpurse>
                    <ESCP_Pawnkind_ThievesGuild_Operative>1</ESCP_Pawnkind_ThievesGuild_Operative>
                </options>
            </li>

            <li>
                <kindDef>Trader</kindDef>
                <commonality>60</commonality>
                <options>
                    <ESCP_Pawnkind_ThievesGuild_Cutpurse>1</ESCP_Pawnkind_ThievesGuild_Cutpurse>
                </options>
                <traders>
                    <ESCP_Pawnkind_ThievesGuild_Fence>1</ESCP_Pawnkind_ThievesGuild_Fence>
                </traders>
                <carriers>
                    <Muffalo>3</Muffalo>
                    <Donkey>2</Donkey>
                </carriers>
            </li>

        </pawnGroupMakers>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 30)</li>
                <li>(70, 45)</li>
                <li>(700, 90)</li>
                <li>(1300, 140)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(0, 0)</li>
                <li>(100, 20)</li>
                <li>(1000, 75)</li>
                <li>(3000, 100)</li>
            </points>
        </raidLootValueFromPointsCurve>

        <modExtensions Inherit="False">
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
        </modExtensions>

    </FactionDef>

</Defs>
