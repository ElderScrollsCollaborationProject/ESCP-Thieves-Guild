<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <QuestScriptDef>
        <defName>ESCP_Quest_ThievesGuild_TwilightSepulcher</defName>
        <rootSelectionWeight>1</rootSelectionWeight>
        <rootMinPoints>300</rootMinPoints>
        <defaultChallengeRating>3</defaultChallengeRating>
        <canGiveRoyalFavor>false</canGiveRoyalFavor>
        <expireDaysRange>8~12</expireDaysRange>
        <questNameRules>
            <rulesStrings>
                <li>questName->Thieves Guild: The Twilight Sepulcher</li>
                <li>questName->Thieves Guild: Darkness Returns</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[asker_nameDef] has word that grave robbers have broken into the Twilight Sepulcher, Nocturnal's temple and the place every Nightingale swears the oath. The Guild wants them gone before the Ebonmere is fouled.\n\nDrive them out and the colony's master thieves may kneel before the Ebonmere and swear themselves to Nocturnal. Only three may hold the title at once.</li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="ESCP.Ranks.QuestNode_RankTierHeld">
                    <tier>ESCP_Rank_ThievesGuild_MasterThief</tier>
                    <notIfCompleted>ESCP_Quest_ThievesGuild_TwilightSepulcher</notIfCompleted>
                </li>
                <li Class="ESCP.Guilds.QuestNode_GetGuildFactionLeader">
                    <factionDefName>ESCP_Faction_ThievesGuild</factionDefName>
                    <storeLeaderAs>asker</storeLeaderAs>
                    <storeFactionAs>guildFaction</storeFactionAs>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_RandomizePointsChallengeRating</def>
                    <parms>
                        <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
                        <pointsFactorThreeStar>2</pointsFactorThreeStar>
                    </parms>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_AdjustPointsForDistantFight</def>
                </li>
                <li Class="QuestNode_GetMap" />
                <li Class="QuestNode_GetSiteTile">
                    <storeAs>siteTile</storeAs>
                    <preferCloserTiles>true</preferCloserTiles>
                </li>
                <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
                    <storeAs>sitePartDefs</storeAs>
                    <storeFactionAs>siteFaction</storeFactionAs>
                    <sitePartsTags>
                        <li>
                            <tag>ESCP_Site_RelicCache</tag>
                        </li>
                    </sitePartsTags>
                </li>
                <li Class="QuestNode_GetDefaultSitePartsParams">
                    <tile>$siteTile</tile>
                    <faction>$siteFaction</faction>
                    <sitePartDefs>$sitePartDefs</sitePartDefs>
                    <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_GenerateSite</def>
                </li>
                <li Class="QuestNode_SpawnWorldObjects">
                    <worldObjects>$site</worldObjects>
                    <defsToExcludeFromHyperlinks>Human</defsToExcludeFromHyperlinks>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>site.MapGenerated</inSignal>
                    <node Class="ESCP.Core.RadiantQuests.QuestNode_AddCacheSecuredPart">
                        <mapTile>$siteTile</mapTile>
                        <completeSignal>sepulcherCleared</completeSignal>
                    </node>
                </li>
                <li Class="QuestNode_WorldObjectTimeout">
                    <worldObject>$site</worldObject>
                    <isQuestTimeout>true</isQuestTimeout>
                    <delayTicks>$(randInt(20,35)*60000)</delayTicks>
                    <inSignalDisable>site.MapGenerated</inSignalDisable>
                    <node Class="QuestNode_End">
                        <outcome>Fail</outcome>
                        <sendStandardLetter>true</sendStandardLetter>
                    </node>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>sepulcherCleared</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Notify_PlayerRaidedSomeone">
                                <getRaidersFromMapParent>$site</getRaidersFromMapParent>
                            </li>
                            <li Class="ESCP.Guilds.QuestNode_GuildReputation">
                                <guild>ThievesGuild</guild>
                                <amount>15</amount>
                                <rewardPool>ESCP_ThingSetMaker_ThievesGuildReward</rewardPool>
                            </li>
                            <li Class="QuestNode_Letter">
                                <label TKey="LetterLabelSepulcherCleared">The Ebonmere</label>
                                <text TKey="LetterTextSepulcherCleared">The Twilight Sepulcher is quiet again. The Ebonmere stirs as your thieves pass, and the oath is waiting for any master thief willing to swear it.\n\nA master thief can now be raised to Nightingale from the rank roster, while there are fewer than three.</text>
                                <letterDef>PositiveEvent</letterDef>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Success</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>
            </nodes>
        </root>
    </QuestScriptDef>

</Defs>
